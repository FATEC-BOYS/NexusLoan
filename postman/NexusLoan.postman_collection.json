{
  "info": {
    "name": "Nexus Loan",
    "description": "Fluxo de demonstração: onboarding → login → cliente → empréstimo. Rode as pastas em ordem. Para testar isolamento, limpe tenantSlug/adminEmail/adminPassword/token, rode a pasta 1 de novo e tente GET do clienteId anterior (404).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Onboarding & Auth",
      "item": [
        {
          "name": "Criar tenant + ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"{{$randomCompanyName}}\",\n  \"tenantSlug\": \"{{tenantSlug}}\",\n  \"adminName\": \"{{$randomFullName}}\",\n  \"adminEmail\": \"{{adminEmail}}\",\n  \"adminPassword\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Cria slug, e-mail e senha aleatórios quando ainda não foram definidos",
                  "if (!pm.collectionVariables.get('tenantSlug')) pm.collectionVariables.set('tenantSlug', 'tenant-' + Math.random().toString(36).slice(2, 8));",
                  "if (!pm.collectionVariables.get('adminEmail')) pm.collectionVariables.set('adminEmail', 'admin@' + pm.collectionVariables.get('tenantSlug') + '.example.com');",
                  "if (!pm.collectionVariables.get('adminPassword')) pm.collectionVariables.set('adminPassword', pm.variables.replaceIn('{{$randomPassword}}') + 'Aa1!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('tenantId', pm.response.json().tenantId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant\": \"{{tenantSlug}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar usuário USER (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"password\": \"{{$randomPassword}}Aa1!\",\n  \"role\": \"USER\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuários (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Clientes",
      "item": [
        {
          "name": "Criar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{$randomFullName}}\",\n  \"document\": \"{{document}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"monthlyIncome\": 5000.0\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Gera um CPF válido e aleatório para cada requisição",
                  "const d = Array.from({length: 9}, () => Math.floor(Math.random() * 10));",
                  "const dv = (arr) => { const n = arr.length + 1; const s = arr.reduce((acc, v, i) => acc + v * (n - i), 0); const m = s % 11; return m < 2 ? 0 : 11 - m; };",
                  "d.push(dv(d)); d.push(dv(d));",
                  "pm.collectionVariables.set('document', d.join(''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clienteId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes?page=0&size=20&sort=createdAt,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            }
          }
        },
        {
          "name": "Buscar cliente por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes",
                "{{clienteId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Empréstimos",
      "item": [
        {
          "name": "Solicitar empréstimo (aprovado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emprestimos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emprestimos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"amount\": 30000.0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('APPROVED', () => pm.expect(pm.response.json().status).to.eql('APPROVED'));",
                  "pm.collectionVariables.set('emprestimoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Solicitar empréstimo (reprovado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/emprestimos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emprestimos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"amount\": 50000.01\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('REJECTED', () => pm.expect(pm.response.json().status).to.eql('REJECTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar empréstimo por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emprestimos/{{emprestimoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emprestimos",
                "{{emprestimoId}}"
              ]
            }
          }
        },
        {
          "name": "Listar empréstimos do cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emprestimos/cliente/{{clienteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emprestimos",
                "cliente",
                "{{clienteId}}"
              ]
            }
          }
        },
        {
          "name": "Listar empréstimos do tenant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/emprestimos?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "emprestimos"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Actuator",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Metrics (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/metrics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "metrics"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tenantSlug",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "tenantId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "document",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "emprestimoId",
      "value": ""
    }
  ]
}