# Copie para .env e preencha. O arquivo .env não é versionado.

POSTGRES_DB=nexusloan
POSTGRES_USER=nexusloan
# Defina uma senha forte.
POSTGRES_PASSWORD=

# Chave HMAC do JWT, com no mínimo 32 bytes. Para gerar: openssl rand -base64 48
JWT_SECRET=

# Opcionais
JWT_EXPIRATION=PT1H
LOAN_MAX_INCOME_MULTIPLIER=10
SPRING_PROFILES_ACTIVE=
